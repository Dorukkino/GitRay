public static void CleanBrowsers(string local, string roaming)
{
    var targets = new[]
    {
        Path.Combine(local, @"Google\Chrome\User Data\Default\Cache"),
        Path.Combine(roaming, @"Mozilla\Firefox\Profiles\demo.default\cookies.sqlite"),
    };
    foreach (var t in targets)
    {
        if (File.Exists(t)) File.Delete(t);
        else if (Directory.Exists(t)) Directory.Delete(t, true);
    }
}

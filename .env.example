# Optional: fine-grained GitHub token with read-only access to public repositories.
# Raises the GitHub API limit from 60 to 5,000 requests per hour (a new scan uses 5).
GITHUB_TOKEN=

# Optional: Postgres connection string (Neon). Vercel sets it when you connect a
# Neon database in the Storage tab. Without it, nothing is stored and the
# Safe Zone / Scammer lists stay empty.
DATABASE_URL=

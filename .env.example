# Optional: fine-grained GitHub token with read-only access to public repositories.
# Raises the GitHub API limit from 60 to 5,000 requests per hour (a new scan uses 5).
GITHUB_TOKEN=

# Optional: Postgres connection string (Neon). Vercel sets it when you connect a
# Neon database in the Storage tab. Without it, nothing is stored and the
# Safe Zone / Scammer lists stay empty.
DATABASE_URL=

# Optional: VirusTotal API key (free account: virustotal.com -> your profile -> API key).
# Committed programs and release files are then looked up by SHA-256 fingerprint.
# The free key allows 4 lookups a minute and 500 a day for the whole site.
VIRUSTOTAL_API_KEY=

# Optional: the site's public address, e.g. https://gitray.example. Used for
# canonical links, the sitemap, robots.txt and security.txt. On Vercel the
# production domain is used when this is empty, so it is only needed when that
# is not the address people should see.
SITE_URL=

# Optional but recommended: the public contact address shown on the privacy and
# terms pages, in the footer, on the Scammer list (false positive reports) and in
# /.well-known/security.txt. The repository is private, so this is the only way to
# reach the site. Without it those contact lines are left out.
CONTACT_EMAIL=

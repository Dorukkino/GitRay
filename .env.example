# Optional: fine-grained GitHub token with read-only access to public repositories.
# Raises the GitHub API limit from 60 to 5,000 requests per hour (a new scan uses 5).
GITHUB_TOKEN=

# Optional: Postgres connection string (Neon). Vercel sets it when you connect a
# Neon database in the Storage tab. Without it, nothing is stored and the
# Safe Zone / Scammer lists stay empty.
DATABASE_URL=

# Optional: VirusTotal API key (free account: virustotal.com -> your profile -> API key).
# Committed programs and release files are then looked up by SHA-256 fingerprint.
# The free key allows 4 lookups a minute and 500 a day for the whole site.
VIRUSTOTAL_API_KEY=

# Optional: the site's public address. Used for canonical links, the sitemap
# and robots.txt. On Vercel it defaults to https://www.gitray.com.tr
# (src/lib/site.ts), so it is only needed to point somewhere else.
SITE_URL=

# Optional: secret that signs the admin session and the robot-check (captcha)
# tokens. Required for the private admin panel (/dorukadm) and the "report a
# wrong result" form. Use a long random value. Without it those features are off.
ADMIN_SECRET=

# Optional: one-time setup key for the admin account. The first visit to
# /dorukadm asks for this before it lets you create the username and password.
# Set it once, create the account, then it is no longer used.
ADMIN_SETUP_TOKEN=
